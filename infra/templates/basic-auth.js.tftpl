// CloudFront Function：許可していない IP アドレスからのリクエストを 403 で、正しい Basic 認証がないリクエストを 401 で止める
var allowedIps = ${allowed_ips};

function handler(event) {
  if (allowedIps.indexOf(event.viewer.ip) === -1) {
    return {
      statusCode: 403,
      statusDescription: 'Forbidden',
    };
  }

  var auth = event.request.headers.authorization;
  if (auth && auth.value === 'Basic ${credentials}') {
    return event.request;
  }
  return {
    statusCode: 401,
    statusDescription: 'Unauthorized',
    headers: {
      'www-authenticate': { value: 'Basic realm="taskapp"' },
    },
  };
}
