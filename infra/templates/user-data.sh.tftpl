#!/bin/bash
# EC2 を最初に起動したときに 1 回だけ動く。Java・nginx を入れ、Spring Boot を systemd で動かす準備をする。
# jar と画面のファイルは、あとから scripts/deploy-backend.sh・deploy-frontend.sh が SSH で送る
set -eux

dnf install -y java-21-amazon-corretto-headless nginx

# メモリが 1 GB しかないので、足りなくなったときのために 1 GB のスワップを作る
fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile none swap defaults 0 0' >> /etc/fstab

# Spring Boot はログインできない専用のユーザーで動かす
useradd --system --home-dir /opt/taskapp --shell /sbin/nologin taskapp
mkdir -p /opt/taskapp/frontend
chmod 755 /opt/taskapp /opt/taskapp/frontend

cat > /etc/systemd/system/taskapp.service <<'UNIT'
[Unit]
Description=taskapp backend (Spring Boot)
After=network-online.target
Wants=network-online.target
# jar を送る前は起動しない
ConditionPathExists=/opt/taskapp/taskapp.jar

[Service]
User=taskapp
Environment=SPRING_PROFILES_ACTIVE=aws
Environment=AWS_REGION=${region}
Environment=TASKAPP_CARDS_TABLE=${cards_table}
Environment=TASKAPP_COUNTERS_TABLE=${counters_table}
ExecStart=/usr/bin/java -Xmx384m -jar /opt/taskapp/taskapp.jar
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable taskapp

# 画面は /opt/taskapp/frontend から配信し、/api は Spring Boot へ転送する
cat > /etc/nginx/nginx.conf <<'NGINX'
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log notice;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/nginx/access.log;
    sendfile on;
    server_tokens off;

    server {
        listen 80 default_server;
        server_name _;
        root /opt/taskapp/frontend;
        index index.html;

        location /api/ {
            proxy_pass http://127.0.0.1:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
NGINX
systemctl enable --now nginx
